{
  "name": "mujoco-wasm-play",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Playground / glue-layer workspace for MuJoCo WASM artifacts.",
  "license": "MIT",
  "scripts": {
    "lint": "echo TBA",
    "test": "echo TBA",
    "build": "echo TBA",
    "dev": "python ./dev_server.py --root . --port 8080",
    "generate": "npm run generate:ui && npm run generate:protocol",
    "generate:protocol": "node ../local_tools/tools/generate_worker_protocol.mjs",
    "generate:ui": "node ../local_tools/tools/generate_ui_artifacts.mjs",
    "loc": "node ../local_tools/tools/loc_report.mjs",
    "prebuild": "npm run generate",
    "predev": "npm run generate",
    "smoke": "node ../tests/local_tools/scripts/tmp_smoke.mjs",
    "spec:lint": "node ../tests/local_tools/scripts/ci/validate_spec.mjs",
    "test:e2e": "playwright test --config ../tests/playwright.config.ts",
    "ci:guard": "node ../local_tools/tools/forbid_patterns.mjs",
    "ci": "npm run spec:lint && npm run ci:guard && playwright test --config ../tests/playwright.config.ts --reporter=list --timeout=90000"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "ajv": "^8.12.0",
    "serve": "^14.2.1"
  }
}
